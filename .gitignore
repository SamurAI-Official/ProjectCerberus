# ---- Godot 4 ----
# The import cache is machine-local and regenerated on open; the .import files
# themselves ARE committed, because they carry the per-texture import settings
# (lossless, no alpha filtering) that openfight's magenta key (#fa00fa) depends on.
.godot/
/android/
*.translation

# ---- GDExtension build output ----
# Built from vendor/openfight and vendor/nrr; never committed.
/addons/openfight/bin/
/addons/nrr/bin/
*.dSYM/

# ---- tools ----
__pycache__/
*.pyc
/tools/**/out/
/design_sheets/out/

# ---- build logs / scratch ----
/build/
*.log

# ---- macOS ----
.DS_Store

# The reference disc image (Guilty Gear, PS1) is a study benchmark, not an asset.
# 332 MB of third-party copyrighted game data must never be committed.
reference/
