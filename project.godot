; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Cerberus"
config/description="2D fighting game. Multi-universe crossover built on the openfight GDExtension."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; Order matters: settings must be applied before anything draws, and the joypad
; bindings must exist before the engine reads input. GameState loads the
; manifests, so it goes last.
UserSettings="*res://game/autoload/user_settings.gd"
InputBindings="*res://game/autoload/input_bindings.gd"
GameState="*res://game/autoload/game_state.gd"

[display]

window/size/viewport_width=768
window/size/viewport_height=432
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

