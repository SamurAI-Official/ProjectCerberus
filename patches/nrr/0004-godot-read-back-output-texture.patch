diff --git a/engine_plugins/godot/src/nrr_godot.cpp b/engine_plugins/godot/src/nrr_godot.cpp
index 5d8c4ce..ba47dbb 100644
--- a/engine_plugins/godot/src/nrr_godot.cpp
+++ b/engine_plugins/godot/src/nrr_godot.cpp
@@ -241,10 +241,47 @@ Ref<Image> NRRNative::render_frame(const Ref<Image> &p_color,
 		return p_color;
 	}
 
+	/* The runtime REPLACES `output.color` with its own texture, sized to the *model's* output grid -
+	 * 2x the input for the released model, and whatever ratio a model was built for. This binding
+	 * used to ignore that: it downloaded from the input-sized texture it had allocated itself, which
+	 * nrr_render never wrote to, and returned an image that was correctly sized, correctly
+	 * formatted and entirely zero, with get_last_error() clean and last_render_was_passthrough
+	 * false. Read the size and the format back from what the runtime handed over instead of
+	 * assuming either.
+	 *
+	 * The format matters as much as the size: the runtime's output texture is RGB8, so a buffer
+	 * sized for RGBA8 would ask nrr_texture_download for more bytes than the texture holds. */
+	int32_t out_width = width;
+	int32_t out_height = height;
+	Image::Format out_format = Image::FORMAT_RGBA8;
+	size_t out_bytes_per_pixel = kBytesPerPixel;
+	NRRTextureDesc out_desc{};
+	if (output.color == nullptr
+	    || nrr_texture_get_desc(device_, output.color, &out_desc) != NRR_SUCCESS
+	    || out_desc.width == 0 || out_desc.height == 0) {
+		set_error("nrr_render returned no output texture to read back");
+		return p_color;
+	}
+	out_width = static_cast<int32_t>(out_desc.width);
+	out_height = static_cast<int32_t>(out_desc.height);
+	switch (out_desc.format) {
+	case NRR_TEXTURE_FORMAT_RGB8:
+		out_format = Image::FORMAT_RGB8;
+		out_bytes_per_pixel = 3;
+		break;
+	case NRR_TEXTURE_FORMAT_RGBA8:
+		out_format = Image::FORMAT_RGBA8;
+		out_bytes_per_pixel = 4;
+		break;
+	default:
+		set_error("nrr_render returned an output texture in a format this binding cannot read back");
+		return p_color;
+	}
+
 	PackedByteArray bytes;
-	bytes.resize(static_cast<int64_t>(width) * height
-	             * static_cast<int64_t>(kBytesPerPixel));
-	if (nrr_texture_download(device_, output_texture_, bytes.ptrw(),
+	bytes.resize(static_cast<int64_t>(out_width) * out_height
+	             * static_cast<int64_t>(out_bytes_per_pixel));
+	if (nrr_texture_download(device_, output.color, bytes.ptrw(),
 	                         static_cast<size_t>(bytes.size())) != NRR_SUCCESS) {
 		fail("nrr_texture_download");
 		return p_color;
@@ -268,7 +305,7 @@ Ref<Image> NRRNative::render_frame(const Ref<Image> &p_color,
 		last_temporal_state_ = state;
 	}
 	++frame_index_;
-	return Image::create_from_data(width, height, false, Image::FORMAT_RGBA8,
+	return Image::create_from_data(out_width, out_height, false, out_format,
 	                                bytes);
 }
 
