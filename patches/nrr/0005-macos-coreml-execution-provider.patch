+bool ONNXRuntime::append_coreml_provider() {
+#if defined(NRR_HAVE_COREML_EP)
+    if (api_ == nullptr || session_options_ == nullptr) {
+        /* Deferred, exactly as the CUDA and TensorRT arms are: set_execution_provider() runs before
+         * load_model(), when there are no session options to attach to yet, and load_model() applies
+         * the provider again once there are. No note is written here - one written now would shadow
+         * the real outcome. */
+        return false;
+    }
+
+    /* COREML_FLAG_CREATE_MLPROGRAM asks the provider for an MLProgram rather than a NeuralNetwork.
+     * That is what the CoreML EP's own documentation recommends for anything newer than Core ML 5,
+     * and NRR's upscaler is a convolution stack - exactly the shape that falls back to the CPU
+     * node-by-node under the older representation.
+     *
+     * COREML_FLAG_USE_CPU_AND_GPU is the compute-unit request rather than a claim: Core ML still
+     * places each layer, and the alternative flags pin the whole graph somewhere (CPU_ONLY is a
+     * correctness reference, ANY is the same set with the Neural Engine added - and the ANE is
+     * reported by Apple to behave badly on convolution-heavy graphs). This is the choice to make
+     * before there is a measurement, and the measurement is what decides whether NRR keeps it. */
+    uint32_t coreml_flags = COREML_FLAG_CREATE_MLPROGRAM | COREML_FLAG_USE_CPU_AND_GPU;
+
+    /* The return value is the measurement. Unlike CUDA there is no provider library to load and no
+     * driver to probe - on Apple platforms the CoreML provider is compiled into libonnxruntime
+     * itself (see the CMake arm) - so a success here means ORT built the CoreML session options,
+     * and that is all it can mean. Whether the graph then *runs* on the GPU is reported by the
+     * provider at session creation, which is why nothing here claims a device. */
+    OrtStatus* status =
+        OrtSessionOptionsAppendExecutionProvider_CoreML(session_options_, coreml_flags);
+    if (status != nullptr) {
+        provider_note_ =
+            std::string("CoreML execution provider could not be attached: ") +
+            api_->GetErrorMessage(status) +
+            " (falls back to the CPU execution provider)";
+        api_->ReleaseStatus(status);
+        return false;
+    }
+    return true;
+#else
+    /* This ONNX Runtime package has no CoreML provider: the Apple release packages carry it, and
+     * this build found no coreml_provider_factory.h to compile against. */
+    provider_note_ =
+        "requested 'coreml' execution provider, but this ONNX Runtime package has no CoreML "
+        "provider (it is built into the Apple release packages; this build found no "
+        "coreml_provider_factory.h) -> using CPU EP";
+    return false;
+#endif
+}
