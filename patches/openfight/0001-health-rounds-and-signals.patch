diff --git a/src/libopenfight/matchEvents.h b/src/libopenfight/matchEvents.h
new file mode 100644
index 0000000..d35f5a4
--- /dev/null
+++ b/src/libopenfight/matchEvents.h
@@ -0,0 +1,46 @@
+#ifndef OPEN_FIGHT_MATCH_EVENTS_H
+#define OPEN_FIGHT_MATCH_EVENTS_H
+
+#include <string>
+
+// Project Cerberus addition.
+//
+// openfight already resolves hits: CollisionAction::doAction() calls
+// opponent->updateState(to_opponent, true) and reports success, and the
+// defender's own action table decides whether that lands as block_* or
+// hurt_*. What the engine has nowhere to put is everything a match needs on top
+// of that -- health, rounds, and any way to tell the host about them. Player has
+// no health field at all, GameContext has no round concept, and OpenFightNode
+// exposes no signals.
+//
+// These structs are that seam. CollisionAction pushes a HIT, GameContext owns
+// the round state machine and pushes the round events, and OpenFightNode drains
+// the list once per frame and re-emits it as Godot signals.
+
+enum class MatchEventType {
+    HIT,
+    ROUND_STARTED,
+    ROUND_ENDED,
+    MATCH_ENDED,
+};
+
+struct MatchEvent {
+    MatchEventType type = MatchEventType::HIT;
+
+    // HIT
+    int attacker = -1;      // 0 or 1
+    int defender = -1;      // 0 or 1
+    int damage = 0;         // damage actually applied (chip damage when blocked)
+    bool blocked = false;
+    std::string strength;   // the trigger that landed: "HIT_L" / "HIT_M" / "HIT_H" / ...
+    std::string state;      // the defender's resulting state name
+
+    // ROUND_ENDED / MATCH_ENDED
+    int winner = -1;        // -1 means a draw (double KO or equal health at time over)
+    bool time_over = false;
+
+    // ROUND_STARTED
+    int round = 0;
+};
+
+#endif
