+    // it is where health and the match event belong. `player` is the attacker --
+    // or the projectile, which carries the attacker's copied listener and player
+    // number -- and `opponent` is the defender.
+    const string defender_state = opponent->getCurrentState();
+    const bool blocked = stateIsBlock(defender_state);
+    const int damage = damageForTrigger(to_opponent, blocked);
+
+    opponent->takeDamage(damage);
+
+    if (player->hasMatchListener()) {
+        MatchEvent event;
+        event.type = MatchEventType::HIT;
+        event.attacker = player->getPlayerNumber();
+        event.defender = opponent->getPlayerNumber();
+        event.damage = damage;
+        event.blocked = blocked;
+        event.strength = to_opponent;
+        event.state = defender_state;
+        player->notifyMatch(event);
+    }
