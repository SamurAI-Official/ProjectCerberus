 }
+
+// ---------------------------------------------------------------------------
+// Project Cerberus: health, identity, round reset
+// ---------------------------------------------------------------------------
+
+int Player::getHealth() const {
+    return health;
+}
+
+int Player::getMaxHealth() const {
+    return max_health;
+}
+
+bool Player::isKO() const {
+    return health <= 0;
+}
+
+void Player::takeDamage(int amount) {
+    if (amount <= 0)
+        return;
+
+    health -= amount;
+
+    if (health < 0)
+        health = 0;
+}
+
+void Player::setPlayerNumber(int number) {
+    player_number = number;
+}
+
+int Player::getPlayerNumber() const {
+    return player_number;
+}
+
+const std::string &Player::getCurrentState() const {
+    return current_state;
+}
+
+void Player::setMatchListener(std::function<void(const MatchEvent &)> listener) {
+    match_listener = std::move(listener);
+}
+
+bool Player::hasMatchListener() const {
+    return static_cast<bool>(match_listener);
+}
+
+void Player::notifyMatch(const MatchEvent &event) {
+    if (match_listener)
+        match_listener(event);
+}
+
+void Player::resetForRound() {
+    health = max_health;
+    is_hurt = false;
+
+    x_pos = spawn_x;
+    y_pos = spawn_y;
+    alpha = spawn_alpha;
+    scale = spawn_scale;
+
+    // Clear latched inputs. Without this a round can start with the previous
+    // round's "holding back"/"holding down" still set. PlayerAgent only writes
+    // state[key] when a key CHANGES, so a key held across the round boundary
+    // reads as released until it is let go for the first time -- acceptable,
+    // and better than carrying a block into the next round.
+    for (auto &entry : state)
+        entry.second = false;
+    state["INVERT"] = inverted;
+
+    // Not every character has to define `start`, and setCurrentState() would
+    // dereference a null animation if it does not.
+    if (animation_manager->get("start") != NULL) {
+        setCurrentState("start");
+        animation_manager->get(current_state)->restart();
+        animation_manager->get(current_state)->update(x_pos, y_pos, scale, inverted);
+    }
+}
