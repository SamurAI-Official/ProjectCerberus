+// ---------------------------------------------------------------------------
+// Project Cerberus: match state
+// ---------------------------------------------------------------------------
+
+void OpenFightNode::emitMatchEvents() {
+    if (game == nullptr)
+        return;
+
+    // Take a batch COPY before iterating. Emitting a signal runs GDScript
+    // synchronously, and a handler is very likely to call reset_match() or
+    // start_round() -- which would mutate the vector being iterated and, worse,
+    // invalidate the reference. Clearing first also means an event is delivered
+    // exactly once.
+    const std::vector<MatchEvent> batch = game->getEvents();
+    game->clearEvents();
+
+    for (const MatchEvent &event : batch) {
+        switch (event.type) {
+        case MatchEventType::HIT:
+            emit_signal(StringName("hit"), event.attacker, event.defender, event.damage, event.blocked,
+                        String(event.strength.c_str()), String(event.state.c_str()));
+            break;
+        case MatchEventType::ROUND_STARTED:
+            emit_signal(StringName("round_started"), event.round);
+            break;
+        case MatchEventType::ROUND_ENDED:
+            emit_signal(StringName("round_ended"), event.winner, event.time_over);
+            break;
+        case MatchEventType::MATCH_ENDED:
+            emit_signal(StringName("match_ended"), event.winner);
+            break;
+        }
+    }
+}
