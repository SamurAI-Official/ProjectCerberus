+namespace {
+
+// Damage per landed trigger. The triggers the shipped data actually uses are
+// HIT_L, HIT_M, HIT_H, KNOCK_DOWN and THROWN (grep `opponent:` across data/), so
+// all five are covered rather than only the three HIT_* ones.
+//
+// An unrecognised trigger falls back to the medium value instead of dealing
+// zero: a silently harmless attack is far harder to notice than a wrong number,
+// and this table is the only place damage is decided.
+int damageForTrigger(const string &trigger, bool blocked) {
+    int damage = 7; // HIT_M, and the fallback
+
+    if (trigger == "HIT_L")
+        damage = 4;
+    else if (trigger == "HIT_M")
+        damage = 7;
+    else if (trigger == "HIT_H")
+        damage = 11;
+    else if (trigger == "KNOCK_DOWN")
+        damage = 10;
+    else if (trigger == "THROWN")
+        damage = 9;
+
+    if (blocked)
+        damage = 1; // chip damage
+
+    return damage;
+}
+
+// openfight represents blocking as a state name, not a flag. The defender's own
+// action table maps a HIT_* trigger to block_low/block_high while holding back
+// and to hurt_* otherwise, and updateState() reports success for either -- so the
+// prefix of the resulting state is the only available block check.
+bool stateIsBlock(const string &state) {
+    return state.rfind("block", 0) == 0;
+}
+
