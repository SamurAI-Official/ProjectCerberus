+
+// ---------------------------------------------------------------------------
+// Project Cerberus: round flow
+// ---------------------------------------------------------------------------
+
+void GameContext::checkRoundEnd() {
+    auto p1 = player_one.getPlayer();
+    auto p2 = player_two.getPlayer();
+    if (p1 == nullptr || p2 == nullptr)
+        return;
+
+    const bool ko1 = p1->isKO();
+    const bool ko2 = p2->isKO();
+
+    if (ko1 || ko2) {
+        // Double KO is a draw, and neither fighter is credited a round win.
+        int winner = -1;
+        if (ko1 && !ko2)
+            winner = 1;
+        else if (ko2 && !ko1)
+            winner = 0;
+
+        finishRound(winner, false);
+        return;
+    }
+
+    if (round_time_ms >= ROUND_TIME_MS) {
+        // Time over: more health wins, equal health is a draw. There is no
+        // sudden death yet -- noted rather than silently chosen.
+        int winner = -1;
+        if (p1->getHealth() > p2->getHealth())
+            winner = 0;
+        else if (p2->getHealth() > p1->getHealth())
+            winner = 1;
+
+        finishRound(winner, true);
+    }
+}
+
+void GameContext::finishRound(int winner, bool time_over) {
+    round_over = true;
+    round_over_ms = 0.0f;
+    round_ended_by_time = time_over;
+
+    if (winner >= 0 && winner < 2) {
+        round_wins[winner]++;
+
+        if (round_wins[winner] >= ROUNDS_TO_WIN) {
+            match_over = true;
+            match_winner = winner;
+        }
+    }
+
+    MatchEvent ended;
+    ended.type = MatchEventType::ROUND_ENDED;
+    ended.winner = winner;
+    ended.time_over = time_over;
+    pushEvent(ended);
+
+    if (match_over) {
+        MatchEvent finished;
+        finished.type = MatchEventType::MATCH_ENDED;
+        finished.winner = match_winner;
+        pushEvent(finished);
+    }
+}
+
+void GameContext::startRound() {
+    if (!initialized)
+        return;
+
+    round++;
+    round_time_ms = 0.0f;
+    round_over = false;
+    round_over_ms = 0.0f;
+    round_ended_by_time = false;
+
+    // Instanced projectiles must go. The fighters must NOT: they are owned by
+    // PlayerAgent through shared_ptr, and clear() deletes what it holds -- which
+    // is exactly why shutdown() detaches "0" and "1" first. Mirrored here.
+    object_manager->detach("0");
+    object_manager->detach("1");
+    object_manager->clear();
+
+    auto p1 = player_one.getPlayer();
+    auto p2 = player_two.getPlayer();
+
+    if (p1 != nullptr) {
+        p1->resetForRound();
+        object_manager->add("0", p1.get());
+    }
+
+    if (p2 != nullptr) {
+        p2->resetForRound();
+        object_manager->add("1", p2.get());
+    }
+
+    MatchEvent started;
+    started.type = MatchEventType::ROUND_STARTED;
+    started.round = round;
+    pushEvent(started);
+}
+
+void GameContext::resetMatch() {
+    round = 0;
+    round_wins[0] = 0;
+    round_wins[1] = 0;
+    round_time_ms = 0.0f;
+    round_over = false;
+    round_over_ms = 0.0f;
+    round_ended_by_time = false;
+    match_over = false;
+    match_winner = -1;
+
+    startRound();
+}
+
+// ---------------------------------------------------------------------------
+// Project Cerberus: accessors and the event queue
+// ---------------------------------------------------------------------------
+
+int GameContext::getHealth(int player) const {
+    if (player == 0 && player_one.getPlayer() != nullptr)
+        return player_one.getPlayer()->getHealth();
+
+    if (player == 1 && player_two.getPlayer() != nullptr)
+        return player_two.getPlayer()->getHealth();
+
+    return 0;
+}
+
+int GameContext::getRound() const {
+    return round;
+}
+
+int GameContext::getRoundWins(int player) const {
+    if (player >= 0 && player < 2)
+        return round_wins[player];
+
+    return 0;
+}
+
+int GameContext::getRoundTimeMs() const {
+    return static_cast<int>(round_time_ms);
+}
+
+bool GameContext::isRoundOver() const {
+    return round_over;
+}
+
+bool GameContext::isMatchOver() const {
+    return match_over;
+}
+
+int GameContext::getMatchWinner() const {
+    return match_winner;
+}
+
+const std::vector<MatchEvent> &GameContext::getEvents() const {
+    return events;
+}
+
+void GameContext::clearEvents() {
+    events.clear();
+}
+
+void GameContext::pushEvent(const MatchEvent &event) {
+    // A malformed character could otherwise queue events without bound if the
+    // host stopped draining. OpenFightNode drains every frame, so this cap
+    // should never be reached in practice.
+    if (events.size() >= 256)
+        events.erase(events.begin());
+
+    events.push_back(event);
 }
