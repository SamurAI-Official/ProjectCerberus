+
+int OpenFightNode::get_round_time_ms() const {
+    return game != nullptr ? game->getRoundTimeMs() : 0;
+}
+
+bool OpenFightNode::is_round_over() const {
+    return game != nullptr && game->isRoundOver();
+}
+
+bool OpenFightNode::is_match_over() const {
+    return game != nullptr && game->isMatchOver();
+}
+
+int OpenFightNode::get_match_winner() const {
+    return game != nullptr ? game->getMatchWinner() : -1;
+}
+
+void OpenFightNode::start_round() {
+    if (game != nullptr)
+        game->startRound();
+}
